{
  "name": "sketch-world",
  "main": "worker/index.ts",
  // Newest date the bundled local workerd (1.20261023) supports.
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // No "routes": deploy goes to *.workers.dev only.

  // Vite builds dist/. Unknown paths such as /w/:id fall back to index.html.
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/a/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sketch-world-db",
      "database_id": "0f1a2aeb-08bd-431b-b6ce-eed4db5af212",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sketch-world-assets" }],
  // namespace_ids 74031–74035 are reserved for sketch-world in the shared account (undo-manual uses 74011–74013).
  "ratelimits": [
    { "name": "RL_UNDERSTAND", "namespace_id": "74031", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_POINT", "namespace_id": "74032", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_SEGMENT", "namespace_id": "74033", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_BACKDROP", "namespace_id": "74034", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_SAVE", "namespace_id": "74035", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": {
    // Deployed cap: $5 per UTC day, raised for judging week at the user's request (was $2). The code falls back to $5
    // if this is missing or not a number.
    "DAILY_COST_CAP_USD": "5",
    // Each client (an IPv4 address, an IPv6 /64) may spend at most $0.50 of the day's cap (10–14 worlds), so one
    // person cannot use up everyone's budget (docs/review.md finding 5). The code falls back to $0.50 the same way.
    "PER_IP_DAILY_USD": "0.5",
    // Sample worlds from gate drawings 1.jpeg and ms2.png (re-made at task 12) and ms1.png (task 11.3). The first is
    // Home's "Walk a sample world".
    "SAMPLE_WORLD_IDS": "wLeiDFftn0,Tco7s8pREl,3gQJnD3lHP"
  },
  // Value comes from .dev.vars locally and `wrangler deploy --secrets-file .dev.vars` when deployed.
  "secrets": { "required": ["MODEL_API_KEY"] }
}
